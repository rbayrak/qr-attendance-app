# Google Sheets API Configuration (Backend Only - GÜVENLİ)
# ⚠️ UYARI: NEXT_PUBLIC_ prefix'i KULLANMAYIN! Client-side'da görünür olur!
SPREADSHEET_ID=your_sheet_id_here

# Google Service Account Credentials (Backend Only - GÜVENLİ)
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com

# Google OAuth (Sadece Öğretmen için - Client-side)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_oauth_client_id_here
NEXT_PUBLIC_GOOGLE_API_KEY=your_api_key_here

# Öğretmen paneli şifresi (QR kodlar da bu şifreyle imzalanır). Tanımlı değilse eski
# varsayılan şifre geçerlidir, ancak o şifre herkese açık olduğu için mutlaka ayarlayın.
# TEACHER_PASSWORD=guclu_bir_sifre

# Öğretmen panelindeki "Ev" konum seçeneği (test için). Yalnızca TEACHER_PASSWORD da
# ayarlıysa görünür; tanımlı değilse yalnızca "Okul" seçilebilir.
# Koordinatları buraya değil, Vercel ortam değişkenine yazın (repo herkese açık).
# HOME_LOCATION=41.0000000,29.0000000

# Optional Configurations
# MAX_DISTANCE=0.1 # Maximum allowed distance in kilometers
# QR_VALIDITY_DURATION=300000 # QR code validity duration in milliseconds
